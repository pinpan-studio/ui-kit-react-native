{
  "expo": {
    "name": "UI Kit RN",
    "slug": "ui-kit-react-native",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "studio.pinpan.uikitrn"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006a6a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "studio.pinpan.uikitrn"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-font", "expo-splash-screen", "expo-asset"],
    "scheme": "uikitrn",
    "experiments": {
      "typedRoutes": false
    }
  }
}
